{
  "name": "Jotter — Markdown Notes & Journal",
  "short_name": "Jotter",
  "description": "Fast, private markdown notes & journal that lives in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f2ec",
